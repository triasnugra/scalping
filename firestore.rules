rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Laporan untuk Claude: koleksi "laporan", ID dokumen = 12 digit angka
    match /laporan/{id} {
      allow read: if true;
      allow create, update: if id.matches('^[0-9]{12}$')
        && request.resource.data.keys().hasOnly(['tanggal','diperbarui'])
        && request.resource.data.tanggal is string
        && (request.resource.data.tanggal == ''
            || request.resource.data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.diperbarui == request.time;
      allow delete: if false;
    }

    // Koleksi lain ditutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
